{
  "name": "job-scout",
  "version": "0.1.0",
  "description": "Agentic CLI that finds and tailors job applications from your living profile.",
  "type": "module",
  "bin": {
    "job-scout": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "html-to-text": "^9.0.5",
    "unpdf": "^0.12.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.5.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "^2.0.5"
  }
}
