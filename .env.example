# LLM backend: "subscription" (default) routes through the Claude Code `claude` CLI
# and uses your Claude Pro/Max subscription — NO API key needed (just `claude` installed
# + logged in). Set "api" to use the Anthropic API instead (requires ANTHROPIC_API_KEY).
# LAPEL_BACKEND=subscription

# Only needed when LAPEL_BACKEND=api.
# ANTHROPIC_API_KEY=

# Optional model overrides
# LAPEL_MODEL_WORKER=claude-sonnet-4-6
# LAPEL_MODEL_SYNTH=claude-opus-4-8
# LAPEL_DEBUG=1
